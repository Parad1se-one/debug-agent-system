{
  "schema_version": "kg_v2.terminology_context_policies.v2",
  "description": "Declarative context gates for noun concepts whose bare aliases are unsafe to resolve without a surrounding noun or task signal. v2 adds missing negation context and narrows over-broad expansions identified in terminology AB test v1.",
  "policies": [
    {
      "canonical_name": "USB接口",
      "require_allow_if_bare": true,
      "allow_if_any": ["USB设备", "USB外设", "USB接口", "USB口", "外设", "拔插", "供电", "无法识别", "初始化", "静电"],
      "block_if_any": ["USB协议", "协议栈", "descriptor", "枚举失败", "协议"],
      "reason": "USB协议/协议栈是通信语义，不能被裸 USB 接口别名覆盖；需要硬件上下文"
    },
    {
      "canonical_name": "回流焊设备",
      "require_allow_if_bare": true,
      "allow_if_any": ["回流焊设备", "产线设备", "设备故障", "设备问题"],
      "block_if_any": ["回流焊工艺", "工艺", "温度曲线", "焊接温度", "制程", "工艺参数"],
      "reason": "回流焊工艺/温度曲线是过程语义，不能直接解析为设备实体"
    },
    {
      "canonical_name": "设备驱动程序",
      "require_allow_if_bare": true,
      "allow_if_any": ["设备驱动", "驱动程序", "显卡", "网卡", "相机", "设备管理器", "驱动问题", "驱动更新"],
      "block_if_any": ["业务增长", "业务", "营收", "市场", "增长因素", "季度", "业绩"],
      "reason": "驱动裸词需要硬件或系统上下文，业务语境不得扩展到设备驱动"
    },
    {
      "canonical_name": "PCIe接口",
      "require_allow_if_bare": true,
      "allow_if_any": ["PCIe网卡", "PCIe插槽", "PCIe接口", "PCIe卡", "网卡", "采集卡"],
      "block_if_any": [],
      "reason": "PCIe 裸缩写只在硬件/接口上下文才安全解析为接口实体"
    },
    {
      "canonical_name": "HDMI接口",
      "require_allow_if_bare": true,
