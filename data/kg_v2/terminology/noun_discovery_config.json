{
  "schema_version": "kg_v2.noun_discovery_config.v1",
  "description": "面向设备、部件、软件、接口、工件、数据对象和业务系统的名词候选目录。这里只定义需要从多源语料验证的候选，不代表已经批准进入 KG。",
  "max_examples_per_candidate": 5,
  "corpus_sources": {
    "chat_jsonl": [
      "imports/**/all_text_messages.jsonl"
    ],
    "document_chunks": [
      "raw/aoi_debug_agent_sources/chunks/debug_chunks.json"
    ],
    "support_records": [
      "raw/aoi_debug_agent_sources/技术支持记录表_*/base_records/*/records.json"
    ]
  },
  "open_discovery": {
    "enabled": true,
    "description": "开放发现只提取高精度的设备机型、程序/配置/数据库/日志文件名和显式简称声明；所有结果仍需人工审核。",
    "model_minimum_count": 3,
    "artifact_minimum_count": 3,
    "variant_minimum_count": 2,
    "explicit_alias_minimum_count": 2,
    "associations": {
      "enabled": true,
      "minimum_record_count": 8,
      "minimum_source_kinds": 2,
      "minimum_jaccard": 0.03,
      "max_neighbors_per_concept": 3,
      "max_candidates": 120,
      "max_terms_per_record": 20,
      "max_examples_per_candidate": 3
    }
  },
