# Copy to .env.local and fill real values locally. Do not commit real secrets.
# Enable optional DeepSeek W2 extraction leaf only when explicitly needed.
DEBUG_AGENT_SYSTEM_W2_DEEPSEEK=0
DEEPSEEK_API_KEY=
DEEPSEEK_W2_MODEL=deepseek-v4-pro
DEEPSEEK_W2_TOOL_MODEL=deepseek-v4-pro
DEEPSEEK_W2_TIMEOUT=240
DEEPSEEK_W2_MAX_TOKENS=32768

# Optional, explicit read-only Jira offline export refresh.
JIRA_BASE_URL=https://jira.example.com
JIRA_ACCOUNT=
JIRA_PWD=
# Prefer a PAT over account/password when one is available.
JIRA_PAT=
